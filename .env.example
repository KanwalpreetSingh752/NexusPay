# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexuspay_admin:nexuspay_secure_dev@localhost:5432/nexuspay?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=nexuspay_super_secret_access_jwt_key_32chars_min
JWT_REFRESH_SECRET=nexuspay_super_secret_refresh_jwt_key_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Test Mode Credentials
# Replace with your actual rzp_test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_NexusDemoKey01
RAZORPAY_KEY_SECRET=NexusDemoSecretKey123456
RAZORPAY_WEBHOOK_SECRET=NexusDemoWebhookSecret999
RAZORPAY_SIMULATION_MODE=true
