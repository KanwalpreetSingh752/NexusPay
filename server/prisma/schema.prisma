datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum KeyEnvironment {
  TEST
}

enum IntentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum AttemptStatus {
  INITIATED
  PENDING_PROVIDER
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum JournalEntryType {
  PAYMENT_CAPTURE
  REFUND_FULL
  REFUND_PARTIAL
  RECONCILIATION_ADJUSTMENT
}

model Merchant {
  id              String         @id @default(uuid()) @db.Uuid
  businessName    String         @map("business_name") @db.VarChar(255)
  email           String         @unique @db.VarChar(255)
  currency        String         @default("INR") @db.Char(3)
  status          MerchantStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  users            User[]
  apiKeys          ApiKey[]
  paymentIntents   PaymentIntent[]
  idempotencies    IdempotencyRecord[]
  webhookEndpoints MerchantWebhookEndpoint[]
  journalEntries   TransactionJournalEntry[]

  @@map("merchants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  merchantId   String    @map("merchant_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("admin") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([merchantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  family    String   @db.VarChar(64)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
  @@map("refresh_tokens")
}

model ApiKey {
  id          String         @id @default(uuid()) @db.Uuid
  merchantId  String         @map("merchant_id") @db.Uuid
  name        String         @db.VarChar(100)
  keyPrefix   String         @map("key_prefix") @db.VarChar(16)
  keyHash     String         @unique @map("key_hash") @db.VarChar(255)
  environment KeyEnvironment @default(TEST)
  isActive    Boolean        @default(true) @map("is_active")
  lastUsedAt  DateTime?      @map("last_used_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([keyPrefix, isActive])
  @@map("api_keys")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  merchantId     String            @map("merchant_id") @db.Uuid
  operation      String            @db.VarChar(100)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseCode   Int?              @map("response_code")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, operation, idempotencyKey], name: "merchant_op_key_unique")
  @@index([status, createdAt])
  @@map("idempotency_records")
}

model PaymentIntent {
  id             String       @id @default(uuid()) @db.Uuid
  merchantId     String       @map("merchant_id") @db.Uuid
  amount         BigInt
  currency       String       @default("INR") @db.Char(3)
  status         IntentStatus @default(REQUIRES_PAYMENT)
  capturedAmount BigInt       @default(0) @map("captured_amount")
  refundedAmount BigInt       @default(0) @map("refunded_amount")
  description    String?      @db.VarChar(500)
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  merchant       Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  attempts       PaymentAttempt[]
  refunds        Refund[]
  journalEntries TransactionJournalEntry[]

  @@index([merchantId, status])
  @@index([merchantId, createdAt(sort: Desc), id])
  @@map("payment_intents")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  paymentIntentId   String        @map("payment_intent_id") @db.Uuid
  attemptNumber     Int           @default(1) @map("attempt_number")
  status            AttemptStatus @default(INITIATED)
  paymentMethod     String?       @map("payment_method") @db.VarChar(50)
  provider          String        @default("razorpay") @db.VarChar(50)
  providerOrderId   String?       @map("provider_order_id") @db.VarChar(255)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(255)
  providerSignature String?       @map("provider_signature") @db.VarChar(500)
  failureCode       String?       @map("failure_code") @db.VarChar(100)
  failureMessage    String?       @map("failure_message") @db.VarChar(1000)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([paymentIntentId, attemptNumber])
  @@map("payment_attempts")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentIntentId  String       @map("payment_intent_id") @db.Uuid
  amount           BigInt
  currency         String       @default("INR") @db.Char(3)
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(255)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(255)
  failureMessage   String?      @map("failure_message") @db.VarChar(1000)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  paymentIntent  PaymentIntent             @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  journalEntries TransactionJournalEntry[]

  @@index([paymentIntentId, status])
  @@map("refunds")
}

model ProviderWebhookEvent {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String              @default("razorpay") @db.VarChar(50)
  providerEventId String              @unique @map("provider_event_id") @db.VarChar(255)
  eventType       String              @map("event_type") @db.VarChar(100)
  payload         Json
  status          ProviderEventStatus @default(RECEIVED)
  errorMessage    String?             @map("error_message") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  processedAt     DateTime?           @map("processed_at")

  @@index([status, createdAt])
  @@map("provider_webhook_events")
}

model MerchantWebhookEndpoint {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @map("merchant_id") @db.Uuid
  url              String   @db.VarChar(2048)
  secretHash       String   @map("secret_hash") @db.VarChar(255)
  isActive         Boolean  @default(true) @map("is_active")
  subscribedEvents String[] @map("subscribed_events")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([merchantId, isActive])
  @@map("merchant_webhook_endpoints")
}

model MerchantWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(100)
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id") @db.Uuid
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("merchant_webhook_events")
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  attemptNumber  Int       @default(1) @map("attempt_number")
  httpStatusCode Int?      @map("http_status_code")
  responseBody   String?   @map("response_body") @db.Text
  errorMessage   String?   @map("error_message") @db.Text
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  endpoint MerchantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  event    MerchantWebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([endpointId, eventId])
  @@map("webhook_deliveries")
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  maxRetries    Int          @default(10) @map("max_retries")
  nextRetryAt   DateTime     @default(now()) @map("next_retry_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

model TransactionJournalEntry {
  id              String           @id @default(uuid()) @db.Uuid
  merchantId      String           @map("merchant_id") @db.Uuid
  paymentIntentId String           @map("payment_intent_id") @db.Uuid
  refundId        String?          @map("refund_id") @db.Uuid
  entryType       JournalEntryType @map("entry_type")
  grossAmount     BigInt           @map("gross_amount")
  feeAmount       BigInt           @default(0) @map("fee_amount")
  netAmount       BigInt           @map("net_amount")
  currency        String           @default("INR") @db.Char(3)
  description     String           @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")

  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  refund        Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([paymentIntentId])
  @@map("transaction_journal_entries")
}
